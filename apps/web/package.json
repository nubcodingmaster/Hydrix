{
  "name": "hydrix-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "data:sync": "npm run data:base && npm run data:environment && npm run data:history && npm run data:project && npm run data:ai",
    "data:base": "node scripts/sync-data.mjs",
    "data:environment": "node scripts/enrich-environment.mjs",
    "data:history": "node scripts/fetch-climate-history-noaa.mjs",
    "data:project": "node scripts/build-projections.mjs",
    "data:ai": "node scripts/generate-ai-summaries.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "geotiff": "^3.0.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
