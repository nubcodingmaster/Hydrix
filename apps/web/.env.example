# Local generator configuration. Never use a VITE_ prefix for credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional local generation cap. Automatic GitHub jobs use eight locations.
AI_MAX_NEW_LOCATIONS=8

# Required only when acquiring Earth Engine observations locally.
EARTH_ENGINE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional short-lived alternative to the service-account file above.
EARTH_ENGINE_ACCESS_TOKEN=
